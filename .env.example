# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit .env.

# PostgreSQL. Ekstensi cube + earthdistance dipakai untuk pencarian jarak.
# Buat database dulu, lalu jalankan migrasi dan seed Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lapak_peta"

# Rahasia aplikasi untuk menyegel cookie sesi (nuxt-auth-utils).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_APP_SECRET="ganti-dengan-32-byte-acak"

# MiomiPay (sumber: https://pg.miomidev.com). Kunci sandbox berawalan MP-SB-.
# Daftar gratis di https://pg.miomidev.com/register lalu buat proyek.
# Kunci hanya dipakai di server, tidak pernah dikirim ke peramban.
MIOMIPAY_SANDBOX_KEY="MP-SB-xxxxxxxx"
MIOMIPAY_WEBHOOK_SECRET="whsec_xxxxxxxx"
MIOMIPAY_BASE_URL="https://pg.miomidev.com/api/v1"
MIOMIPAY_ENV="sandbox"