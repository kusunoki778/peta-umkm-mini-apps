# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit .env.

# PostgreSQL + PostGIS. Buat database dulu, lalu jalankan migrasi Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lapak_peta"

# Kunci sesi nuxt-auth-utils. Minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_SESSION_PASSWORD="ganti-dengan-32-karakter-acak-minimal"

# Midtrans (sandbox). Ambil dari dashboard Midtrans.
MIDTRANS_SERVER_KEY=""
NUXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
NUXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"
